{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services/sourcing-chine",
      "destination": "/wanisource",
      "permanent": true
    },
    {
      "source": "/services/sourcing-chine.html",
      "destination": "/wanisource",
      "permanent": true
    },
    {
      "source": "/services/reservation",
      "destination": "/#tarifs",
      "permanent": true
    },
    {
      "source": "/services/budget-marketing",
      "destination": "/#tarifs",
      "permanent": true
    },
    {
      "source": "/realisations/clean-and-polish",
      "destination": "/#realisations",
      "permanent": true
    },
    {
      "source": "/realisations/aesthetic-men",
      "destination": "/#realisations",
      "permanent": true
    },
    {
      "source": "/blog/reservation-en-ligne-rendez-vous-oublies",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/meta-ads-commerce-local-petit-budget",
      "destination": "/blog/",
      "permanent": true
    }
  ]
}
