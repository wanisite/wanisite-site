{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/realisations/clean-and-polish",
      "destination": "/realisations/clean-and-polish.html"
    },
    {
      "source": "/realisations/aesthetic-men",
      "destination": "/realisations/aesthetic-men.html"
    },
    {
      "source": "/realisations/garage-idf",
      "destination": "/realisations/garage-idf.html"
    }
  ]
}